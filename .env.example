# --- Server ---
PORT=3000
APP_URL=http://localhost:3000

# --- Auth ---
SESSION_SECRET=replace_with_a_long_random_string
ADMIN_EMAIL=admin@example.com
ADMIN_INITIAL_PASSWORD=changeme123

# --- Email (for password reset) ---
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your@email.com
SMTP_PASS=your_smtp_password
SMTP_FROM=noreply@example.com

# --- Database ---
MONGODB_URI=mongodb://localhost:27017/seminar_dashboard

# --- GHL Webhook Security ---
# Shared secret you configure in the GHL workflow's webhook action (sent as a header or
# query param — see src/webhooks/ghlWebhook.js for exactly how it's checked).
GHL_WEBHOOK_SECRET=replace_with_a_long_random_string
# API key (Bearer token) used server-side to fetch GHL pipeline stages during seminar registration.
GHL_API_KEY=your_ghl_private_api_key
# Location ID from GHL — used to fetch all pipelines for the registration form.
GHL_LOCATION_ID=your_ghl_location_id

# --- Meta (Facebook) Ads API ---
META_APP_ID=your_meta_app_id
META_APP_SECRET=your_meta_app_secret
# Short-lived token you generate once via Graph API Explorer / OAuth to bootstrap the system.
# After first run, the app exchanges this for a long-lived token and stores/refreshes it in the DB —
# you should not need to touch this again unless the refresh flow fails and alerts you.
META_INITIAL_ACCESS_TOKEN=paste_a_short_lived_token_here_once
# Ad account ID (with act_ prefix, e.g. act_123456789) used to list campaigns in the dashboard.
META_AD_ACCOUNT_ID=act_your_account_id

# --- Alerting (optional but recommended) ---
# Webhook URL (Slack incoming webhook, or any endpoint) to notify on:
# - unmapped pipeline_id received
# - Meta token refresh failure
ALERT_WEBHOOK_URL=
