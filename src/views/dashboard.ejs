  <script>
    const g = id => document.getElementById(id);
    const fmt = {
      currency: v => v == null ? '—' : '$' + Number(v).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }),
      pct:      v => v == null ? '—' : Number(v).toFixed(1) + '%',
      int:      v => v == null ? '—' : Math.round(Number(v)).toLocaleString(),
    };

    function setRange(days) {
      const to = new Date(), from = new Date();
      from.setDate(from.getDate() - days);
      g('date-to').value   = to.toISOString().slice(0, 10);
      g('date-from').value = from.toISOString().slice(0, 10);
    }
    function setThisWeek() {
      const to = new Date(), from = new Date();
      from.setDate(from.getDate() - from.getDay() + (from.getDay() === 0 ? -6 : 1));
      g('date-to').value   = to.toISOString().slice(0, 10);
      g('date-from').value = from.toISOString().slice(0, 10);
    }
    function setThisMonth() {
      const to = new Date(), from = new Date(to.getFullYear(), to.getMonth(), 1);
      g('date-to').value   = to.toISOString().slice(0, 10);
      g('date-from').value = from.toISOString().slice(0, 10);
    }
    setRange(30);
    loadDashboard();

    fetch('/api/seminars').then(r => r.json()).then(list => {
      const sel = g('seminar-filter');
      list.forEach(s => {
        const o = document.createElement('option');
        o.value = s.seminar_id;
        o.textContent = s.name + (s.event_date ? '  (' + s.event_date.slice(0, 10) + ')' : '');
        sel.appendChild(o);
      });
    }).catch(() => {});

    let funnelChart = null;

    async function loadDashboard() {
      const from = g('date-from').value, to = g('date-to').value;
      const seminar = g('seminar-filter').value;
      if (!from || !to) { alert('Please select a date range.'); return; }

      const btn = g('apply-btn');
      btn.textContent = 'Loading…';
      btn.disabled = true;
      g('loader').classList.remove('hidden');

      const sumParams   = 'date_from=' + from + '&date_to=' + to + (seminar ? '&seminar_id=' + seminar : '');
      const tableParams = 'date_from=' + from + '&date_to=' + to;
      const leadsParams = seminar ? 'seminar_id=' + seminar : '';

      try {
        const [summary, table] = await Promise.all([
          fetch('/api/dashboard/summary?' + sumParams).then(r => { if (!r.ok) throw r; return r.json(); }),
          fetch('/api/dashboard/table?'   + tableParams).then(r => { if (!r.ok) throw r; return r.json(); }),
        ]);
        renderSummary(summary);
        renderTable(table);
        g('last-updated').textContent = 'Updated ' + new Date().toLocaleTimeString();
      } catch (e) {
        console.error(e);
        g('last-updated').textContent = 'Error loading data';
      } finally {
        btn.textContent = 'Apply';
        btn.disabled = false;
        g('loader').classList.add('hidden');
      }
      fetch('/api/leads?' + leadsParams).then(r => r.json()).then(renderLeadsTable).catch(() => {
        g('leads-table-body').innerHTML = '<tr><td colspan="6" class="text-center py-6 text-slate-500">Could not load leads</td></tr>';
      });
    }

    function renderSummary(d) {
      const r = d.raw_counts, m = d.metrics;

      g('kpi-spend').textContent                  = fmt.currency(r.total_spend);
      g('kpi-leads').textContent                  = fmt.int(r.leads);
      g('kpi-cpl-sub').textContent               = 'CPL: ' + fmt.currency(m.cost_per_lead);
      g('kpi-registered').textContent            = fmt.int(r.registered);
      g('kpi-lead-reg-sub').textContent          = 'Lead→Reg: ' + fmt.pct(m.lead_to_registration_rate_pct);
      g('kpi-attended').textContent              = fmt.int(r.attended);
      g('kpi-attend-rate-sub').textContent       = 'Reg→Attend: ' + fmt.pct(m.attendance_rate_pct);
      g('kpi-consult-booked').textContent        = fmt.int(r.consult_booked);
      g('kpi-consult-booked-sub').textContent    = 'Attend→Consult: ' + fmt.pct(m.attendee_to_consult_rate_pct);
      g('kpi-consult-completed').textContent     = fmt.int(r.consult_completed);
      g('kpi-consult-completed-sub').textContent = 'Booked→Done: ' + fmt.pct(m.pct_consults_occurred);
      g('kpi-sales').textContent                 = fmt.int(r.closed_won);
      g('kpi-close-rate-sub').textContent        = 'Close Rate: ' + fmt.pct(m.close_rate_pct);

      g('m-cpl').textContent  = fmt.currency(m.cost_per_lead);
      g('m-cpr').textContent  = fmt.currency(m.cost_per_registration);
      g('m-cpa').textContent  = fmt.currency(m.cost_per_attendee);
      g('m-cpcb').textContent = fmt.currency(m.cost_per_consult_booked);
      g('m-cpcc').textContent = fmt.currency(m.cost_per_consult_completed);
      g('m-cps').textContent  = fmt.currency(m.cost_per_sale);

      renderFunnel(r);
    }

    function renderFunnel(r) {
      const labels = ['Leads', 'Registered', 'Attended', 'Consult Booked', 'Consult Completed', 'Closed Won'];
      const values = [r.leads, r.registered, r.attended, r.consult_booked, r.consult_completed, r.closed_won];
      const colors = ['#3b82f6', '#6366f1', '#8b5cf6', '#a855f7', '#ec4899', '#10b981'];

      if (funnelChart) funnelChart.destroy();
      funnelChart = new Chart(g('funnel-chart'), {
        type: 'bar',
        data: {
          labels,
          datasets: [{
            data: values,
            backgroundColor: colors.map(c => c + '30'),
            borderColor: colors,
            borderWidth: 2,
            borderRadius: 6,
            borderSkipped: false,
          }]
        },
        options: {
          indexAxis: 'y',
          responsive: true,
          maintainAspectRatio: false,
          plugins: {
            legend: { display: false },
            tooltip: {
              backgroundColor: '#1e293b',
              borderColor: '#334155',
              borderWidth: 1,
              titleColor: '#cbd5e1',
              bodyColor: '#94a3b8',
              callbacks: { label: ctx => '  ' + Number(ctx.raw).toLocaleString() + ' people' }
            }
          },
          scales: {
            x: {
              grid: { color: '#1e293b' },
              ticks: { color: '#64748b', font: { size: 11, family: 'Inter' } }
            },
            y: {
              grid: { display: false },
              ticks: { color: '#94a3b8', font: { size: 12, family: 'Inter' } }
            }
          }
        }
      });
    }

    let tableData = [], sortCol = 'event_date', sortDir = -1;

    function renderTable(rows) {
      tableData = rows;
      g('table-count').textContent = rows.length + ' seminar' + (rows.length === 1 ? '' : 's');
      sortAndRender();
    }

    function sortAndRender() {
      const sorted = [...tableData].sort((a, b) => {
        let av = a[sortCol], bv = b[sortCol];
        if (av == null && bv == null) return 0;
        if (av == null) return 1;
        if (bv == null) return -1;
        return (av < bv ? -1 : av > bv ? 1 : 0) * sortDir;
      });

      const esc = s => String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');

      g('seminar-table-body').innerHTML = sorted.length === 0
        ? '<tr><td colspan="10" class="text-center px-5 py-10 text-slate-500">No seminars in this date range</td></tr>'
        : sorted.map(r => `
          <tr class="border-b border-slate-700/50 hover:bg-slate-700/30 transition-colors">
            <td class="px-5 py-3.5 font-medium text-white max-w-[200px] truncate">${esc(r.name)}</td>
            <td class="px-4 py-3.5 text-right text-slate-200">${r.total_spend ? fmt.currency(r.total_spend) : '—'}</td>
            <td class="px-4 py-3.5 text-right text-slate-200">${fmt.int(r.registered)}</td>
            <td class="px-4 py-3.5 text-right text-slate-200">${fmt.int(r.attended)}</td>
            <td class="px-4 py-3.5 text-right text-slate-200">${fmt.int(r.consult_booked)}</td>
            <td class="px-4 py-3.5 text-right text-slate-200">${fmt.int(r.consult_completed)}</td>
            <td class="px-4 py-3.5 text-right font-semibold text-emerald-300">${fmt.int(r.closed_won)}</td>
            <td class="px-4 py-3.5 text-right text-slate-200">${fmt.currency(r.cost_per_attendee)}</td>
            <td class="px-4 py-3.5 text-right text-slate-200">${fmt.pct(r.close_rate_pct)}</td>
            <td class="px-5 py-3.5 text-right font-semibold text-blue-300">${fmt.currency(r.cost_per_sale)}</td>
          </tr>`).join('');

      document.querySelectorAll('th.sortable').forEach(th => {
        th.classList.remove('sort-asc', 'sort-desc');
        if (th.dataset.col === sortCol) th.classList.add(sortDir === 1 ? 'sort-asc' : 'sort-desc');
      });
    }

    document.querySelectorAll('th.sortable').forEach(th => {
      th.addEventListener('click', () => {
        sortDir = (sortCol === th.dataset.col) ? sortDir * -1 : -1;
        sortCol = th.dataset.col;
        sortAndRender();
      });
    });

    // ── Tab switching ──────────────────────────────────────────────
    const TABS = ['dashboard', ...(<%= isLoggedIn %> ? ['webhook', 'seminars'] : [])];
    function switchTab(tab) {
      TABS.forEach(t => {
        g('page-' + t)?.classList.toggle('hidden', t !== tab);
        const btn = g('tab-btn-' + t);
        if (btn) btn.className = 'text-xs font-semibold px-3.5 py-1.5 rounded-md transition-colors ' +
          (t === tab ? 'bg-slate-700 text-white' : 'text-slate-400 hover:text-white');
      });
      if (tab === 'webhook')  initWebhookTab();
      if (tab === 'seminars') initSeminarsTab();
    }

    // ── Webhook tab ────────────────────────────────────────────────
    let webhookTabInit = false;

    function initWebhookTab() {
      // URL is always the current origin + path
      g('webhook-url').textContent = window.location.origin + '/webhooks/ghl';

      fetch('/api/webhook/config').then(r => r.json()).then(c => {
        const el = g('secret-status');
        if (c.secret_configured) {
          el.textContent = '✓ Configured';
          el.className = 'text-xs font-semibold text-emerald-400';
        } else {
          el.textContent = '⚠ Not set — add GHL_WEBHOOK_SECRET to .env';
          el.className = 'text-xs font-semibold text-amber-400';
        }
      }).catch(() => {});

      if (!webhookTabInit) {
        webhookTabInit = true;
        loadWebhookEvents();
      }
    }

    async function loadWebhookEvents() {
      g('webhook-events-body').innerHTML = '<tr><td colspan="6" class="text-center py-8 text-slate-500">Loading…</td></tr>';
      try {
        const events = await fetch('/api/webhook/events').then(r => r.json());
        renderWebhookEvents(events);
      } catch (e) {
        g('webhook-events-body').innerHTML = '<tr><td colspan="6" class="text-center py-8 text-slate-500">Error loading events</td></tr>';
      }
    }

    function renderWebhookEvents(events) {
      const esc = s => String(s ?? '—').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
      const ts  = d => d ? new Date(d).toLocaleString() : '—';

      if (!events.length) {
        g('webhook-events-body').innerHTML = '<tr><td colspan="6" class="text-center py-12 text-slate-500">No webhook events received yet</td></tr>';
        return;
      }

      g('webhook-events-body').innerHTML = events.map((e, i) => {
        const badge = e.type === 'mapped'
          ? '<span class="inline-flex px-2 py-0.5 rounded-full text-xs font-semibold bg-emerald-500/20 text-emerald-400">Mapped</span>'
          : '<span class="inline-flex px-2 py-0.5 rounded-full text-xs font-semibold bg-amber-500/20 text-amber-400">Unmapped</span>';

        const contact = e.type === 'mapped'
          ? `<span class="font-mono text-xs">${esc(e.contact_id)}</span>`
          : `<span class="font-mono text-xs text-amber-400">${esc(e.pipeline_name)}</span>`;

        const seminar = e.type === 'mapped'
          ? esc(e.seminar)
          : '<span class="text-amber-400 text-xs">No seminar match</span>';

        const stage = e.type === 'mapped'
          ? `<span class="font-mono text-xs text-blue-300">${esc(e.stage_role)}</span>`
          : '—';

        const eventTime = e.type === 'mapped' ? ts(e.event_timestamp) : '—';

        const viewData = e.payload || { contact_id: e.contact_id, seminar: e.seminar, stage_role: e.stage_role, event_timestamp: e.event_timestamp };

        const payloadToggle = `<button onclick="togglePayload(${i})" class="text-xs text-slate-400 hover:text-blue-400 underline ml-2">view data ↕</button>`;

        const payloadRow = `<tr id="wh-payload-${i}" class="hidden"><td colspan="6" class="px-5 pb-4 pt-1">
             <pre class="bg-slate-900 border border-slate-700 rounded-lg p-3 text-xs text-slate-300 overflow-x-auto max-h-60">${esc(JSON.stringify(viewData, null, 2))}</pre>
           </td></tr>`;

        return `<tr class="border-b border-slate-700/50 hover:bg-slate-700/20 transition-colors">
          <td class="px-5 py-3">${badge}</td>
          <td class="px-4 py-3 text-xs text-slate-400">${ts(e.received_at)}</td>
          <td class="px-4 py-3">${contact}${payloadToggle}</td>
          <td class="px-4 py-3 text-slate-200">${seminar}</td>
          <td class="px-4 py-3">${stage}</td>
          <td class="px-5 py-3 text-xs text-slate-500">${eventTime}</td>
        </tr>${payloadRow}`;
      }).join('');
    }

    function togglePayload(i) {
      const row = g('wh-payload-' + i);
      if (row) row.classList.toggle('hidden');
    }

    // ── Seminars tab ───────────────────────────────────────────────
    const ROLE_LABELS = [
      { role: 'registered',        label: 'Registered' },
      { role: 'attended',          label: 'Attended' },
      { role: 'consult_booked',    label: 'Consult Booked' },
      { role: 'consult_completed', label: 'Consult Completed' },
      { role: 'closed_won',        label: 'Closed Won' },
      { role: 'closed_lost',       label: 'Closed Lost' },
    ];

    // Shared stage-mapping row builder (registration + edit)
    // idToRole: { stageId: role } — pass null for new registration
    function buildStageRows(stages, prefix, idToRole) {
      const esc = s => String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
      const baseOpts =
        '<option value="">— ignore —</option>' +
        ROLE_LABELS.map(({ role, label }) => `<option value="${role}">${label}</option>`).join('') +
        '<option value="__custom__" class="text-blue-400">✏ Custom…</option>';

      const rows = stages.map((s, i) => {
        const selId  = `${prefix}-${i}`;
        const custId = `${prefix}-custom-${i}`;
        const cur    = idToRole ? (idToRole[s.id] || '') : '';
        const isCustom = cur && !ROLE_LABELS.find(r => r.role === cur);

        // inject selected attr — custom picks the __custom__ option
        const targetVal = isCustom ? '__custom__' : cur;
        const opts = targetVal
          ? baseOpts.replace(`value="${targetVal}"`, `value="${targetVal}" selected`)
          : baseOpts;

        const requiredRole = ROLE_LABELS.find(r => r.role === cur);
        const badge = requiredRole
          ? `<span class="text-[10px] font-semibold px-1.5 py-0.5 rounded bg-blue-500/20 text-blue-300 shrink-0">${requiredRole.label}</span>`
          : '';

        return `
          <div class="flex items-center gap-2.5 rounded-xl px-3 py-2.5 bg-slate-800/70 border border-slate-700/50 hover:border-slate-600/70 transition-colors group">
            <span class="w-6 h-6 rounded-lg bg-slate-700 text-slate-400 text-[10px] font-bold flex items-center justify-center shrink-0 group-hover:bg-slate-600 transition-colors">${i + 1}</span>
            <span class="text-sm text-slate-100 font-medium truncate flex-1 min-w-0" title="${esc(s.name)}">${esc(s.name)}</span>
            ${badge}
            <select id="${selId}" onchange="onStageRoleChange(this,'${custId}');syncStageRoles('${prefix}',${stages.length})"
              class="bg-slate-700/80 border border-slate-600/80 hover:border-slate-500 rounded-lg px-2 py-1.5 text-xs text-white focus:outline-none focus:ring-2 focus:ring-blue-500 w-44 shrink-0 transition-colors cursor-pointer">
              ${opts}
            </select>
            <input id="${custId}" type="text" placeholder="e.g. pre_registered" value="${isCustom ? esc(cur) : ''}"
              class="${isCustom ? '' : 'hidden '}bg-slate-700 border border-blue-500/70 rounded-lg px-2 py-1.5 text-xs text-white placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-blue-500 w-32 shrink-0">
          </div>`;
      }).join('');

      return `
        <div class="flex items-center gap-2 px-3 mb-2">
          <span class="w-6 shrink-0"></span>
          <span class="text-xs font-medium text-slate-500 flex-1">GHL Stage</span>
          <span class="text-xs font-medium text-slate-500 w-44 shrink-0 text-center">Funnel Role</span>
        </div>
        <div class="space-y-1.5 max-h-80 overflow-y-auto pr-0.5 scrollbar-thin">${rows}</div>`;
    }

    function onStageRoleChange(sel, custId) {
      const inp = g(custId);
      if (!inp) return;
      if (sel.value === '__custom__') { inp.classList.remove('hidden'); inp.focus(); }
      else { inp.classList.add('hidden'); inp.value = ''; }
    }

    function syncStageRoles(prefix, total) {
      // collect all roles currently picked across rows
      const picked = new Set();
      for (let i = 0; i < total; i++) {
        const v = g(`${prefix}-${i}`)?.value;
        if (v && v !== '__custom__') picked.add(v);
      }
      // disable already-picked options in every other row's select
      for (let i = 0; i < total; i++) {
        const sel = g(`${prefix}-${i}`);
        if (!sel) continue;
        const own = sel.value;
        for (const opt of sel.options) {
          if (!opt.value || opt.value === '__custom__') continue;
          opt.disabled = picked.has(opt.value) && opt.value !== own;
          opt.classList.toggle('text-slate-600', opt.disabled);
        }
      }
    }

    let seminarsTabInit = false;
    function initSeminarsTab() {
      if (!seminarsTabInit) {
        seminarsTabInit = true;
        loadSeminarsList().then(() => loadGHLPipelines());
        loadMetaCampaigns();
      }
    }

    let seminarsList = [];

    async function loadSeminarsList() {
      const body = g('seminars-list-body');
      body.innerHTML = '<tr><td colspan="6" class="text-center py-8 text-slate-500">Loading…</td></tr>';
      try {
        seminarsList = await fetch('/api/seminars').then(r => r.json());
        const esc = s => String(s ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
        body.innerHTML = seminarsList.length === 0
          ? '<tr><td colspan="7" class="text-center py-10 text-slate-500">No seminars registered yet</td></tr>'
          : seminarsList.map(s => {
            const active = s.active !== false;
            const budgetCell = s.total_spend == null
              ? '<span class="text-slate-600 text-xs">—</span>'
              : s.total_spend === 0
                ? '<span class="text-slate-500 text-xs font-mono">$0</span>'
                : `<span class="text-white font-semibold font-mono">$${Number(s.total_spend).toLocaleString('en-US',{maximumFractionDigits:0})}</span>`;
            return `
            <tr class="border-b border-slate-700/50 hover:bg-slate-700/20 transition-colors">
              <td class="px-5 py-3.5 font-medium ${active ? 'text-white' : 'text-slate-500'}">${esc(s.name)}</td>
              <td class="px-4 py-3.5 text-slate-400">${s.event_date ? s.event_date.slice(0,10) : '—'}</td>
              <td class="px-4 py-3.5 text-slate-400">${esc(s.location) || '—'}</td>
              <td class="px-4 py-3.5 text-slate-400 max-w-[200px] truncate">${s.meta_campaign_name ? esc(s.meta_campaign_name) : '<span class="text-slate-600">—</span>'}</td>
              <td class="px-4 py-3.5">${budgetCell}</td>
              <td class="px-4 py-3.5 text-center">
                <button onclick="toggleActive('${s.seminar_id}', ${active})" title="${active ? 'Deactivate' : 'Activate'}"
                  class="relative inline-flex h-5 w-9 items-center rounded-full transition-colors focus:outline-none ${active ? 'bg-emerald-500' : 'bg-slate-600'}">
                  <span class="inline-block h-3.5 w-3.5 rounded-full bg-white shadow transition-transform ${active ? 'translate-x-4' : 'translate-x-1'}"></span>
                </button>
              </td>
              <td class="px-5 py-3.5">
                <button onclick="editSeminar('${s.seminar_id}')"
                  class="text-xs text-slate-400 hover:text-blue-400 hover:bg-slate-700 px-2.5 py-1.5 rounded-lg transition-colors">
                  Edit
                </button>
              </td>
            </tr>`;
          }).join('');
      } catch (e) {
        body.innerHTML = '<tr><td colspan="6" class="text-center py-8 text-slate-500">Error loading seminars</td></tr>';
      } finally {
        // Re-render campaign dropdowns now that seminarsList is populated,
        // so already-linked campaigns are correctly greyed out.
        filterCampaigns(g('campaign-search')?.value || '');
        editFilterCampaigns(g('edit-campaign-search')?.value || '');
      }
    }

    let allCampaigns = [], selectedCampaignId = '', selectedCampaignName = '';

    const STATUS_STYLE = {
      ACTIVE:      { dot: 'bg-emerald-400', badge: 'text-emerald-400' },
      PAUSED:      { dot: 'bg-amber-400',   badge: 'text-amber-400'   },
      ARCHIVED:    { dot: 'bg-slate-500',   badge: 'text-slate-400'   },
      IN_PROCESS:  { dot: 'bg-blue-400',    badge: 'text-blue-400'    },
      WITH_ISSUES: { dot: 'bg-red-400',     badge: 'text-red-400'     },
    };

    async function loadMetaCampaigns() {
      const status = g('campaign-status');
      g('campaign-list').innerHTML = '<p class="text-center text-slate-500 text-xs py-4">Loading…</p>';
      status.textContent = '';
      status.className = 'text-xs text-slate-500 mt-0.5';
      try {
        const res  = await fetch('/api/meta/campaigns');
        const data = await res.json();
        if (!res.ok) throw new Error(data.error || 'Failed');
        allCampaigns = data.sort((a, b) => {
          const order = { ACTIVE: 0, IN_PROCESS: 1, WITH_ISSUES: 2, PAUSED: 3, ARCHIVED: 4 };
          return (order[a.effective_status] ?? 5) - (order[b.effective_status] ?? 5);
        });
        filterCampaigns('');
        status.textContent = allCampaigns.length + ' campaigns loaded';
      } catch (e) {
        g('campaign-list').innerHTML = '<p class="text-center text-amber-400 text-xs py-4">' + e.message + '</p>';
        status.textContent = 'Failed to load campaigns';
        status.className = 'text-xs text-amber-400 mt-0.5';
      }
    }

    function filterCampaigns(query) {
      const q = (query || g('campaign-search')?.value || '').toLowerCase();
      const filtered = q ? allCampaigns.filter(c => c.name.toLowerCase().includes(q)) : allCampaigns;
      const esc = s => String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');

      const clearItem = `
        <button type="button" onclick="selectCampaign('','')"
          class="w-full text-left px-3 py-2.5 text-sm text-slate-400 hover:bg-slate-700/60 transition-colors flex items-center gap-2.5 border-b border-slate-700/50">
          <span class="w-2 h-2 rounded-full bg-slate-600 shrink-0"></span>
          — no campaign (optional) —
        </button>`;

      const usedCampaignIds = new Set(seminarsList.map(s => s.meta_campaign_id).filter(Boolean));
      const items = filtered.map(c => {
        const st = STATUS_STYLE[c.effective_status] || STATUS_STYLE.PAUSED;
        const isSelected = c.id === selectedCampaignId;
        const isUsed = usedCampaignIds.has(c.id) && c.id !== selectedCampaignId;
        if (isUsed) return `
          <div class="w-full px-3 py-2 text-sm flex items-center gap-2.5 bg-slate-900/40 cursor-not-allowed select-none">
            <span class="w-2 h-2 rounded-full bg-slate-600 shrink-0"></span>
            <span class="flex-1 truncate text-slate-600 line-through">${esc(c.name)}</span>
            <span class="text-[10px] font-semibold px-1.5 py-0.5 rounded bg-slate-700 text-slate-500 shrink-0">linked</span>
          </div>`;
        return `<button type="button" onclick="selectCampaign('${esc(c.id)}', '${esc(c.name).replace(/'/g, '&#39;')}')"
          class="w-full text-left px-3 py-2.5 text-sm hover:bg-slate-700/60 transition-colors flex items-center gap-2.5 ${isSelected ? 'bg-blue-600/20' : ''}">
          <span class="w-2 h-2 rounded-full ${st.dot} shrink-0"></span>
          <span class="flex-1 truncate text-slate-200">${esc(c.name)}</span>
          <span class="text-xs ${st.badge} shrink-0">${c.effective_status}</span>
        </button>`;
      }).join('');

      g('campaign-list').innerHTML = clearItem + (items || '<p class="text-center text-slate-500 text-xs py-3">No matches</p>');
    }

    function selectCampaign(id, name) {
      selectedCampaignId   = id;
      selectedCampaignName = name;
      const label = g('campaign-trigger-label');
      if (id) {
        label.textContent = name;
        label.classList.replace('text-slate-400', 'text-white');
      } else {
        label.textContent = '— no campaign (optional) —';
        label.classList.replace('text-white', 'text-slate-400');
      }
      g('campaign-dropdown-panel').classList.add('hidden');
      g('campaign-chevron').style.transform = '';
      filterCampaigns('');
      if (g('campaign-search')) g('campaign-search').value = '';
    }

    function toggleCampaignDropdown() {
      const panel = g('campaign-dropdown-panel');
      const isOpen = !panel.classList.contains('hidden');
      panel.classList.toggle('hidden', isOpen);
      g('campaign-chevron').style.transform = isOpen ? '' : 'rotate(180deg)';
      if (!isOpen) setTimeout(() => g('campaign-search')?.focus(), 50);
    }

    document.addEventListener('click', e => {
      if (g('pipeline-dropdown-wrapper') && !g('pipeline-dropdown-wrapper').contains(e.target)) {
        g('pipeline-dropdown-panel')?.classList.add('hidden');
        if (g('pipeline-chevron')) g('pipeline-chevron').style.transform = '';
      }
      if (g('campaign-dropdown-wrapper') && !g('campaign-dropdown-wrapper').contains(e.target)) {
        g('campaign-dropdown-panel')?.classList.add('hidden');
        if (g('campaign-chevron')) g('campaign-chevron').style.transform = '';
      }
    });

    let fetchedStages = [];
    let allPipelines = [], selectedPipelineId = '', selectedPipelineName = '';

    async function loadGHLPipelines() {
      const trig   = g('pipeline-trigger');
      const status = g('pipeline-status');
      g('pipeline-trigger-label').textContent = 'Loading pipelines…';
      trig.disabled = true;
      status.textContent = '';
      try {
        const res  = await fetch('/api/ghl/pipelines');
        const data = await res.json();
        if (!res.ok) throw new Error(data.error || 'Failed');
        allPipelines = data;
        trig.disabled = false;
        g('pipeline-trigger-label').textContent = '— select a pipeline —';
        g('pipeline-trigger-label').classList.add('text-slate-400');
        filterPipelines('');
        status.textContent = data.length + ' pipelines loaded';
      } catch (e) {
        g('pipeline-trigger-label').textContent = 'Failed to load pipelines';
        status.textContent = e.message;
      }
    }

    function filterPipelines(query) {
      const q = (query || '').toLowerCase();
      const usedIds = new Set(seminarsList.map(s => s.ghl_pipeline_id).filter(Boolean));
      const filtered = q ? allPipelines.filter(p => p.name.toLowerCase().includes(q)) : allPipelines;
      const esc = s => String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
      const items = filtered.map(p => {
        const used = usedIds.has(p.id);
        const sel  = p.id === selectedPipelineId;
        if (used) return `
          <div class="w-full px-3 py-2 text-sm flex items-center gap-2.5 bg-slate-900/40 cursor-not-allowed select-none">
            <span class="w-2 h-2 rounded-full bg-slate-600 shrink-0"></span>
            <span class="flex-1 truncate text-slate-600 line-through">${esc(p.name)}</span>
            <span class="text-[10px] font-semibold px-1.5 py-0.5 rounded bg-slate-700 text-slate-500 shrink-0">registered</span>
          </div>`;
        return `<button type="button" onclick="selectPipeline('${p.id.replace(/'/g,"&#39;")}','${esc(p.name).replace(/'/g,"&#39;")}')"
          class="w-full text-left px-3 py-2.5 text-sm hover:bg-slate-700/60 transition-colors flex items-center gap-2.5 ${sel ? 'bg-blue-600/20' : ''}">
          <span class="w-2 h-2 rounded-full ${sel ? 'bg-blue-400' : 'bg-slate-500'} shrink-0"></span>
          <span class="flex-1 truncate text-slate-200">${esc(p.name)}</span>
        </button>`;
      }).join('');
      g('pipeline-list').innerHTML = items || '<p class="text-center text-slate-500 text-xs py-3">No matches</p>';
    }

    function selectPipeline(id, name) {
      selectedPipelineId   = id;
      selectedPipelineName = name;
      const label = g('pipeline-trigger-label');
      label.textContent = name;
      label.classList.replace('text-slate-400', 'text-white');
      g('pipeline-dropdown-panel').classList.add('hidden');
      g('pipeline-chevron').style.transform = '';
      filterPipelines(g('pipeline-search')?.value || '');
    }

    function togglePipelineDropdown() {
      const panel  = g('pipeline-dropdown-panel');
      const isOpen = !panel.classList.contains('hidden');
      panel.classList.toggle('hidden', isOpen);
      g('pipeline-chevron').style.transform = isOpen ? '' : 'rotate(180deg)';
      if (!isOpen) setTimeout(() => g('pipeline-search')?.focus(), 50);
    }

    function lockRegistrationSelects() {
      const ptrig = g('pipeline-trigger');
      ptrig.disabled = true;
      ptrig.classList.add('opacity-50', 'pointer-events-none');
      const ctrig = g('campaign-trigger');
      ctrig.disabled = true;
      ctrig.classList.add('opacity-50', 'pointer-events-none');
      g('reg-reset-btn').classList.remove('hidden');
    }

    function resetRegistrationFlow() {
      fetchedStages = []; selectedPipelineId = ''; selectedPipelineName = '';
      g('stage-mapping').classList.add('hidden');
      g('stage-dropdowns').innerHTML = '';
      g('register-result').classList.add('hidden');
      g('reg-reset-btn').classList.add('hidden');
      const ptrig = g('pipeline-trigger');
      ptrig.disabled = false;
      ptrig.classList.remove('opacity-50', 'pointer-events-none');
      g('pipeline-trigger-label').textContent = '— select a pipeline —';
      g('pipeline-trigger-label').className = 'truncate text-slate-400';
      const ctrig = g('campaign-trigger');
      ctrig.disabled = false;
      ctrig.classList.remove('opacity-50', 'pointer-events-none');
      selectCampaign('', '');
      loadGHLPipelines();
    }

    async function fetchGHLStages() {
      if (!selectedPipelineId) { alert('Select a pipeline first.'); return; }
      const pipelineId = selectedPipelineId;

      const btn = g('fetch-stages-btn');
      btn.textContent = 'Fetching stages…'; btn.disabled = true;
      g('stage-mapping').classList.add('hidden');

      try {
        const res  = await fetch(`/api/seminars/stages?pipeline_id=${encodeURIComponent(pipelineId)}`);
        const data = await res.json();
        if (!res.ok) throw new Error(data.error || 'GHL request failed');
        if (!data.length) throw new Error('No stages returned — check the pipeline ID');

        fetchedStages = data;
        g('stage-dropdowns').innerHTML = buildStageRows(data, 'stage-role', null);
        syncStageRoles('stage-role', data.length);
        g('stage-mapping').classList.remove('hidden');
        lockRegistrationSelects();
      } catch (e) {
        alert('Failed to fetch stages: ' + e.message);
      } finally {
        btn.textContent = 'Fetch & Map Stages →'; btn.disabled = false;
      }
    }

    async function registerSeminar() {
      const stageNameToRole = {};
      for (let i = 0; i < fetchedStages.length; i++) {
        let role = g('stage-role-' + i)?.value;
        if (role === '__custom__') role = (g('stage-role-custom-' + i)?.value || '').trim();
        if (role) stageNameToRole[fetchedStages[i].name] = role;
      }
      const meta_campaign_id   = selectedCampaignId   || undefined;
      const meta_campaign_name = selectedCampaignName || undefined;

      if (!selectedPipelineId) { alert('Select a pipeline first.'); return; }

      const payload = {
        name:               selectedPipelineName,
        ghl_pipeline_id:    selectedPipelineId,
        meta_campaign_id,
        meta_campaign_name,
        stage_name_to_role: stageNameToRole,
      };

      const btn = g('register-btn');
      btn.textContent = 'Registering…';
      btn.disabled = true;

      try {
        const res  = await fetch('/api/seminars', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(payload) });
        const data = await res.json();
        if (!res.ok) throw data;

        showRegisterResult('success', `"${data.name}" registered successfully!`);
        await loadSeminarsList();
        resetRegistrationFlow();
      } catch (e) {
        const msg = e.error || (e.missing_roles ? 'Missing stages: ' + e.missing_roles.join(', ') : 'Registration failed');
        showRegisterResult('error', msg);
      } finally {
        btn.textContent = 'Register Seminar';
        btn.disabled = false;
      }
    }

    function showRegisterResult(type, msg) {
      const el = g('register-result');
      el.className = 'mt-1 p-3 rounded-lg text-sm ' + (type === 'success'
        ? 'bg-emerald-500/20 border border-emerald-700/50 text-emerald-300'
        : 'bg-red-500/20 border border-red-700/50 text-red-300');
      el.textContent = msg;
      el.classList.remove('hidden');
      if (type === 'success') setTimeout(() => el.classList.add('hidden'), 5000);
    }

    // ── Seminar edit ───────────────────────────────────────────────
    let editingId = null, editCampaignId = '', editCampaignName = '';
    let editPipelineId = '', editCurrentStageRoleMap = {}, editFetchedStages = [];

    function editSeminar(id) {
      const s = seminarsList.find(x => x.seminar_id === id);
      if (!s) return;
      editingId            = id;
      editPipelineId       = s.ghl_pipeline_id || '';
      editCurrentStageRoleMap = s.stage_role_map || {};
      editFetchedStages    = [];

      g('edit-name').value     = s.name || '';
      g('edit-date').value     = s.event_date ? s.event_date.slice(0,10) : '';
      g('edit-location').value = s.location || '';
      g('edit-pipeline-display').textContent = s.ghl_pipeline_id || '—';
      g('edit-stage-section').classList.add('hidden');
      editSetCampaign(s.meta_campaign_id || '', s.meta_campaign_name || '');
      g('edit-result').classList.add('hidden');
      g('edit-panel').classList.remove('hidden');
      g('edit-panel').scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    }

    async function editFetchStages() {
      if (!editPipelineId) { alert('No pipeline ID on this seminar.'); return; }
      const btn = g('edit-fetch-stages-btn');
      btn.textContent = 'Fetching…'; btn.disabled = true;
      try {
        const res    = await fetch('/api/seminars/stages?pipeline_id=' + encodeURIComponent(editPipelineId));
        const stages = await res.json();
        if (!res.ok) throw new Error(stages.error || 'Failed');
        editFetchedStages = stages;
        renderEditStageDropdowns(stages);
        g('edit-stage-section').classList.remove('hidden');
      } catch (e) {
        alert('Failed to fetch stages: ' + e.message);
      } finally {
        btn.textContent = 'Re-map Stages →'; btn.disabled = false;
      }
    }

    function renderEditStageDropdowns(stages) {
      const idToRole = Object.fromEntries(
        Object.entries(editCurrentStageRoleMap).map(([role, stageId]) => [stageId, role])
      );
      g('edit-stage-dropdowns').innerHTML = buildStageRows(stages, 'edit-stage-role', idToRole);
      syncStageRoles('edit-stage-role', stages.length);
    }

    function closeEditPanel() {
      g('edit-panel').classList.add('hidden');
      editingId = null;
    }

    async function saveEditedSeminar() {
      if (!editingId) return;
      const name = g('edit-name').value.trim();
      if (!name) { alert('Seminar name is required.'); return; }

      const btn = g('edit-save-btn');
      btn.textContent = 'Saving…';
      btn.disabled = true;

      // Collect stage mappings if the remap section is open
      let stage_role_map;
      if (!g('edit-stage-section').classList.contains('hidden') && editFetchedStages.length) {
        stage_role_map = {};
        for (let i = 0; i < editFetchedStages.length; i++) {
          let role = g('edit-stage-role-' + i)?.value;
          if (role === '__custom__') role = (g('edit-stage-role-custom-' + i)?.value || '').trim();
          if (role) stage_role_map[role] = editFetchedStages[i].id;
        }
      }

      try {
        const res  = await fetch('/api/seminars/' + editingId, {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            name,
            event_date:         g('edit-date').value     || undefined,
            location:           g('edit-location').value || undefined,
            meta_campaign_id:   editCampaignId           || undefined,
            meta_campaign_name: editCampaignName         || undefined,
            stage_role_map,
          }),
        });
        const data = await res.json();
        if (!res.ok) throw new Error(data.error || 'Failed');
        showEditResult('success', 'Saved successfully.');
        loadSeminarsList();
      } catch (e) {
        showEditResult('error', e.message);
      } finally {
        btn.textContent = 'Save Changes';
        btn.disabled = false;
      }
    }

    async function toggleActive(id, currentlyActive) {
      try {
        const res = await fetch('/api/seminars/' + id, {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ active: !currentlyActive }),
        });
        if (!res.ok) throw new Error();
        loadSeminarsList();
      } catch {
        alert('Failed to update status.');
      }
    }

    function showEditResult(type, msg) {
      const el = g('edit-result');
      el.className = 'p-3 rounded-lg text-sm ' + (type === 'success'
        ? 'bg-emerald-500/20 border border-emerald-700/50 text-emerald-300'
        : 'bg-red-500/20 border border-red-700/50 text-red-300');
      el.textContent = msg;
      el.classList.remove('hidden');
      if (type === 'success') setTimeout(() => el.classList.add('hidden'), 3000);
    }

    // Edit-panel campaign picker (reuses allCampaigns + STATUS_STYLE from registration scope)
    function editSetCampaign(id, name) {
      editCampaignId   = id;
      editCampaignName = name;
      const label = g('edit-campaign-label');
      if (id && name) {
        label.textContent = name;
        label.classList.replace('text-slate-400', 'text-white');
      } else {
        label.textContent = '— none —';
        if (label.classList.contains('text-white')) label.classList.replace('text-white', 'text-slate-400');
      }
      g('edit-campaign-panel').classList.add('hidden');
      g('edit-campaign-chevron').style.transform = '';
      if (g('edit-campaign-search')) g('edit-campaign-search').value = '';
    }

    function editFilterCampaigns(query) {
      const q = (query || '').toLowerCase();
      const filtered = q ? allCampaigns.filter(c => c.name.toLowerCase().includes(q)) : allCampaigns;
      const esc = s => String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');

      const clear = `<button type="button" onclick="editSetCampaign('','')"
        class="w-full text-left px-3 py-2.5 text-sm text-slate-400 hover:bg-slate-700/60 flex items-center gap-2.5 border-b border-slate-700/50">
        <span class="w-2 h-2 rounded-full bg-slate-600 shrink-0"></span>— none —</button>`;

      const usedIds = new Set(seminarsList.filter(s => s.seminar_id !== editingId).map(s => s.meta_campaign_id).filter(Boolean));
      const items = filtered.map(c => {
        const st   = STATUS_STYLE[c.effective_status] || STATUS_STYLE.PAUSED;
        const isUsed = usedIds.has(c.id);
        if (isUsed) return `
          <div class="w-full px-3 py-2 text-sm flex items-center gap-2.5 bg-slate-900/40 cursor-not-allowed select-none">
            <span class="w-2 h-2 rounded-full bg-slate-600 shrink-0"></span>
            <span class="flex-1 truncate text-slate-600 line-through">${esc(c.name)}</span>
            <span class="text-[10px] font-semibold px-1.5 py-0.5 rounded bg-slate-700 text-slate-500 shrink-0">linked</span>
          </div>`;
        return `<button type="button" onclick="editSetCampaign('${esc(c.id)}','${esc(c.name).replace(/'/g,"&#39;")}')"
          class="w-full text-left px-3 py-2.5 text-sm hover:bg-slate-700/60 flex items-center gap-2.5 ${c.id===editCampaignId?'bg-blue-600/20':''}">
          <span class="w-2 h-2 rounded-full ${st.dot} shrink-0"></span>
          <span class="flex-1 truncate text-slate-200">${esc(c.name)}</span>
          <span class="text-xs ${st.badge} shrink-0">${c.effective_status}</span>
        </button>`;
      }).join('');

      g('edit-campaign-list').innerHTML = clear + (items || '<p class="text-center text-slate-500 text-xs py-3">No matches</p>');
    }

    function editToggleCampaignDropdown() {
      const panel = g('edit-campaign-panel');
      const isOpen = !panel.classList.contains('hidden');
      panel.classList.toggle('hidden', isOpen);
      g('edit-campaign-chevron').style.transform = isOpen ? '' : 'rotate(180deg)';
      if (!isOpen) { editFilterCampaigns(''); setTimeout(() => g('edit-campaign-search')?.focus(), 50); }
    }

    document.addEventListener('click', e => {
      if (g('edit-campaign-wrapper') && !g('edit-campaign-wrapper').contains(e.target)) {
        g('edit-campaign-panel')?.classList.add('hidden');
        if (g('edit-campaign-chevron')) g('edit-campaign-chevron').style.transform = '';
      }
    });

    // ── Leads table (rendered as part of loadDashboard) ────────────
    function renderLeadsTable(leads) {
      const esc = s => String(s ?? '—').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
      const ts  = d => d ? new Date(d).toLocaleString() : '—';
      g('leads-count-badge').textContent = leads.length ? leads.length + ' leads' : '';
      if (!leads.length) {
        g('leads-table-body').innerHTML = '<tr><td colspan="6" class="text-center py-10 text-slate-500">No leads in this range</td></tr>';
        return;
      }
      g('leads-table-body').innerHTML = leads.map(l => `
        <tr class="border-b border-slate-700/50 hover:bg-slate-700/20 transition-colors">
          <td class="px-5 py-3 text-slate-200 font-medium">${esc(l.name)}</td>
          <td class="px-4 py-3 text-slate-400">${esc(l.email)}</td>
          <td class="px-4 py-3 text-slate-400">${esc(l.phone)}</td>
          <td class="px-4 py-3"><span class="font-mono text-xs text-blue-300">${esc(l.current_stage_role || l.current_stage_name)}</span></td>
          <td class="px-4 py-3 text-slate-400 text-xs">${esc(l.seminar_id?.name)}</td>
          <td class="px-4 py-3 text-slate-500 text-xs">${ts(l.created_at)}</td>
        </tr>`).join('');
    }

    function copyWebhookUrl() {
      navigator.clipboard.writeText(g('webhook-url').textContent);
      const btn = g('copy-url-btn');
      btn.textContent = 'Copied!';
      btn.classList.add('bg-emerald-700');
      setTimeout(() => { btn.textContent = 'Copy'; btn.classList.remove('bg-emerald-700'); }, 2000);
    }
  </script>

</body>
</html>
