<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Seminar Performance Dashboard</title>
  <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>📊</text></svg>">
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: { sans: ['Inter', 'system-ui', 'sans-serif'] }
        }
      }
    }
  </script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4"></script>
  <style>
    body { font-family: 'Inter', system-ui, sans-serif; }
    .spin { animation: spin 1s linear infinite; }
    @keyframes spin { to { transform: rotate(360deg); } }
    th.sortable { cursor: pointer; user-select: none; }
    th.sortable:hover { color: #60a5fa; }
    th.sort-asc::after  { content: ' ↑'; color: #60a5fa; }
    th.sort-desc::after { content: ' ↓'; color: #60a5fa; }
  </style>
</head>
<body class="bg-slate-900 text-slate-100 min-h-screen">

  <!-- Header -->
  <header class="bg-slate-800/80 backdrop-blur border-b border-slate-700 sticky top-0 z-10">
    <div class="max-w-screen-2xl mx-auto px-6 py-3 flex items-center justify-between">
      <div class="flex items-center gap-3">
        <div class="w-8 h-8 bg-blue-500 rounded-lg flex items-center justify-center shrink-0">
          <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5"
              d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/>
          </svg>
        </div>
        <div>
          <p class="text-sm font-semibold text-white leading-none">Seminar Dashboard</p>
          <p class="text-xs text-slate-400 mt-0.5">Dinner Seminar Performance</p>
        </div>
      </div>
      <nav class="flex items-center gap-1 bg-slate-900/60 rounded-lg p-1">
        <button id="tab-btn-dashboard" onclick="switchTab('dashboard')"
          class="text-xs font-semibold px-3.5 py-1.5 rounded-md bg-slate-700 text-white transition-colors">
          Dashboard
        </button>
        <% if (isLoggedIn) { %>
        <button id="tab-btn-webhook" onclick="switchTab('webhook')"
          class="text-xs font-semibold px-3.5 py-1.5 rounded-md text-slate-400 hover:text-white transition-colors">
          Webhook
        </button>
        <button id="tab-btn-seminars" onclick="switchTab('seminars')"
          class="text-xs font-semibold px-3.5 py-1.5 rounded-md text-slate-400 hover:text-white transition-colors">
          Seminars
        </button>
        <% } %>
      </nav>

      <div class="flex items-center gap-3">
        <div id="loader" class="hidden">
          <svg class="spin w-4 h-4 text-blue-400" fill="none" viewBox="0 0 24 24">
            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"/>
            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"/>
          </svg>
        </div>
        <span class="text-xs text-slate-500" id="last-updated">Not loaded</span>
        <% if (isLoggedIn) { %>
        <form method="POST" action="/auth/logout" class="inline">
          <button type="submit" class="text-xs text-slate-400 hover:text-red-400 hover:bg-slate-700 px-2.5 py-1.5 rounded-lg transition-colors">Sign Out</button>
        </form>
        <% } else { %>
        <a href="/login" class="text-xs text-slate-400 hover:text-blue-400 hover:bg-slate-700 px-2.5 py-1.5 rounded-lg transition-colors">Sign In</a>
        <% } %>
      </div>
    </div>
  </header>

  <div id="page-dashboard">
  <main class="max-w-screen-2xl mx-auto px-6 py-6 space-y-5">

    <!-- Filters -->
    <div class="bg-slate-800 border border-slate-700 rounded-xl p-4 flex flex-wrap gap-3 items-end">
      <div class="flex flex-col gap-1.5">
        <label class="text-xs font-medium text-slate-400 uppercase tracking-widest">From</label>
        <input type="date" id="date-from"
          class="bg-slate-700 border border-slate-600 rounded-lg px-3 py-2 text-sm text-white focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent">
      </div>
      <div class="flex flex-col gap-1.5">
        <label class="text-xs font-medium text-slate-400 uppercase tracking-widest">To</label>
        <input type="date" id="date-to"
          class="bg-slate-700 border border-slate-600 rounded-lg px-3 py-2 text-sm text-white focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent">
      </div>
      <div class="flex flex-col gap-1.5">
        <label class="text-xs font-medium text-slate-400 uppercase tracking-widest">Seminar</label>
        <select id="seminar-filter"
          class="bg-slate-700 border border-slate-600 rounded-lg px-3 py-2 text-sm text-white focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent min-w-[220px]">
          <option value="">All Seminars</option>
        </select>
      </div>
      <button id="apply-btn" onclick="loadDashboard()"
        class="bg-blue-600 hover:bg-blue-500 active:scale-95 text-white font-semibold px-5 py-2 rounded-lg text-sm transition-all focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 focus:ring-offset-slate-800">
        Apply
      </button>
      <div class="ml-auto flex items-center gap-1">
        <span class="text-xs text-slate-500 mr-1">Quick:</span>
        <button onclick="setThisWeek();loadDashboard()" class="text-xs text-slate-400 hover:text-blue-400 hover:bg-slate-700 px-2.5 py-1.5 rounded-lg transition-colors">This Week</button>
        <button onclick="setThisMonth();loadDashboard()" class="text-xs text-slate-400 hover:text-blue-400 hover:bg-slate-700 px-2.5 py-1.5 rounded-lg transition-colors">This Month</button>
        <button onclick="setRange(30);loadDashboard()" class="text-xs text-slate-400 hover:text-blue-400 hover:bg-slate-700 px-2.5 py-1.5 rounded-lg transition-colors">30d</button>
        <button onclick="setRange(60);loadDashboard()" class="text-xs text-slate-400 hover:text-blue-400 hover:bg-slate-700 px-2.5 py-1.5 rounded-lg transition-colors">60d</button>
        <button onclick="setRange(90);loadDashboard()" class="text-xs text-slate-400 hover:text-blue-400 hover:bg-slate-700 px-2.5 py-1.5 rounded-lg transition-colors">90d</button>
        <button onclick="setRange(365);loadDashboard()" class="text-xs text-slate-400 hover:text-blue-400 hover:bg-slate-700 px-2.5 py-1.5 rounded-lg transition-colors">1yr</button>
      </div>
    </div>

    <!-- Funnel KPI Cards -->
    <div>
      <p class="text-xs font-semibold text-slate-500 uppercase tracking-widest mb-3 px-1">Funnel Volume</p>
      <div class="grid grid-cols-2 md:grid-cols-4 xl:grid-cols-7 gap-3">

        <div class="bg-slate-800 border border-slate-700 rounded-xl p-4 flex flex-col gap-2">
          <div class="flex items-center justify-between">
            <p class="text-xs font-semibold text-slate-400 uppercase tracking-widest">Leads</p>
            <div class="w-7 h-7 rounded-lg bg-blue-500/20 flex items-center justify-center">
              <svg class="w-3.5 h-3.5 text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0"/>
              </svg>
            </div>
          </div>
          <p class="text-2xl font-bold text-white tracking-tight" id="kpi-leads">—</p>
          <p class="text-xs text-slate-500" id="kpi-cpl-sub">CPL: —</p>
        </div>

        <div class="bg-slate-800 border border-slate-700 rounded-xl p-4 flex flex-col gap-2">
          <div class="flex items-center justify-between">
            <p class="text-xs font-semibold text-slate-400 uppercase tracking-widest">Ad Spend</p>
            <div class="w-7 h-7 rounded-lg bg-slate-700 flex items-center justify-center">
              <svg class="w-3.5 h-3.5 text-slate-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
              </svg>
            </div>
          </div>
          <p class="text-2xl font-bold text-white tracking-tight" id="kpi-spend">—</p>
          <p class="text-xs text-slate-500">Total period spend</p>
        </div>

        <div class="bg-slate-800 border border-slate-700 rounded-xl p-4 flex flex-col gap-2">
          <div class="flex items-center justify-between">
            <p class="text-xs font-semibold text-slate-400 uppercase tracking-widest">Registered</p>
            <div class="w-7 h-7 rounded-lg bg-blue-500/20 flex items-center justify-center">
              <svg class="w-3.5 h-3.5 text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/>
              </svg>
            </div>
          </div>
          <p class="text-2xl font-bold text-white tracking-tight" id="kpi-registered">—</p>
          <p class="text-xs text-slate-500" id="kpi-lead-reg-sub">Lead→Reg: —</p>
        </div>

        <div class="bg-slate-800 border border-slate-700 rounded-xl p-4 flex flex-col gap-2">
          <div class="flex items-center justify-between">
            <p class="text-xs font-semibold text-slate-400 uppercase tracking-widest">Attended Seminar</p>
            <div class="w-7 h-7 rounded-lg bg-indigo-500/20 flex items-center justify-center">
              <svg class="w-3.5 h-3.5 text-indigo-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
              </svg>
            </div>
          </div>
          <p class="text-2xl font-bold text-white tracking-tight" id="kpi-attended">—</p>
          <p class="text-xs text-slate-500" id="kpi-attend-rate-sub">Reg→Attend: —</p>
        </div>

        <div class="bg-slate-800 border border-slate-700 rounded-xl p-4 flex flex-col gap-2">
          <div class="flex items-center justify-between">
            <p class="text-xs font-semibold text-slate-400 uppercase tracking-widest">Consult Booked</p>
            <div class="w-7 h-7 rounded-lg bg-violet-500/20 flex items-center justify-center">
              <svg class="w-3.5 h-3.5 text-violet-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/>
              </svg>
            </div>
          </div>
          <p class="text-2xl font-bold text-white tracking-tight" id="kpi-consult-booked">—</p>
          <p class="text-xs text-slate-500" id="kpi-consult-booked-sub">Attend→Consult: —</p>
        </div>

        <div class="bg-slate-800 border border-slate-700 rounded-xl p-4 flex flex-col gap-2">
          <div class="flex items-center justify-between">
            <p class="text-xs font-semibold text-slate-400 uppercase tracking-widest">Consult Completed</p>
            <div class="w-7 h-7 rounded-lg bg-pink-500/20 flex items-center justify-center">
              <svg class="w-3.5 h-3.5 text-pink-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4M7 21l5-5 5 5M3 10l9-9 9 9"/>
              </svg>
            </div>
          </div>
          <p class="text-2xl font-bold text-white tracking-tight" id="kpi-consult-completed">—</p>
          <p class="text-xs text-slate-500" id="kpi-consult-completed-sub">Booked→Done: —</p>
        </div>

        <div class="bg-gradient-to-br from-emerald-900/40 to-emerald-800/20 border border-emerald-700/50 rounded-xl p-4 flex flex-col gap-2">
          <div class="flex items-center justify-between">
            <p class="text-xs font-semibold text-emerald-400 uppercase tracking-widest">Closed / Won</p>
            <div class="w-7 h-7 rounded-lg bg-emerald-500/20 flex items-center justify-center">
              <svg class="w-3.5 h-3.5 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
              </svg>
            </div>
          </div>
          <p class="text-2xl font-bold text-emerald-300 tracking-tight" id="kpi-sales">—</p>
          <p class="text-xs text-emerald-500" id="kpi-close-rate-sub">Close Rate: —</p>
        </div>

      </div>
    </div>

    <!-- Cost Efficiency Row -->
    <div>
      <p class="text-xs font-semibold text-slate-500 uppercase tracking-widest mb-3 px-1">Cost Efficiency</p>
      <div class="grid grid-cols-2 md:grid-cols-4 xl:grid-cols-7 gap-3">
        <div class="bg-slate-800 border border-slate-700 rounded-xl px-4 py-3 flex items-center justify-between">
          <span class="text-xs text-slate-400 font-medium">Cost / Lead</span>
          <span class="text-base font-bold text-white" id="m-cpl">—</span>
        </div>
        <div class="bg-slate-800 border border-slate-700 rounded-xl px-4 py-3 flex items-center justify-between">
          <span class="text-xs text-slate-400 font-medium">Cost / Reg</span>
          <span class="text-base font-bold text-white" id="m-cpr">—</span>
        </div>
        <div class="bg-slate-800 border border-slate-700 rounded-xl px-4 py-3 flex items-center justify-between">
          <span class="text-xs text-slate-400 font-medium">Cost / Attendee</span>
          <span class="text-base font-bold text-white" id="m-cpa">—</span>
        </div>
        <div class="bg-slate-800 border border-slate-700 rounded-xl px-4 py-3 flex items-center justify-between">
          <span class="text-xs text-slate-400 font-medium">Cost / Consult Booked</span>
          <span class="text-base font-bold text-white" id="m-cpcb">—</span>
        </div>
        <div class="bg-slate-800 border border-slate-700 rounded-xl px-4 py-3 flex items-center justify-between">
          <span class="text-xs text-slate-400 font-medium">Cost / Consult Completed</span>
          <span class="text-base font-bold text-white" id="m-cpcc">—</span>
        </div>
        <div class="bg-gradient-to-br from-emerald-900/40 to-emerald-800/20 border border-emerald-700/50 rounded-xl px-4 py-3 flex items-center justify-between">
          <span class="text-xs text-emerald-400 font-medium">Cost / Sale</span>
          <span class="text-base font-bold text-emerald-300" id="m-cps">—</span>
        </div>
      </div>
    </div>

    <!-- Funnel Chart -->
    <div class="bg-slate-800 border border-slate-700 rounded-xl p-6">
      <p class="text-xs font-semibold text-slate-500 uppercase tracking-widest mb-4">Funnel Overview</p>
      <div style="height:200px; position:relative;">
        <canvas id="funnel-chart"></canvas>
      </div>
    </div>

    <!-- Per-Seminar Table -->
    <div class="bg-slate-800 border border-slate-700 rounded-xl overflow-hidden">
      <div class="px-6 py-4 border-b border-slate-700 flex items-center justify-between">
        <p class="text-xs font-semibold text-slate-500 uppercase tracking-widest">Seminars Breakdown</p>
        <span class="text-xs text-slate-500 bg-slate-700 px-2 py-0.5 rounded-full" id="table-count">0 seminars</span>
      </div>
      <div class="overflow-x-auto">
        <table class="w-full text-sm whitespace-nowrap">
          <thead>
            <tr class="border-b border-slate-700">
              <th class="text-left px-5 py-3 text-xs font-semibold text-slate-400 uppercase tracking-widest sortable" data-col="name">Seminar</th>
              <th class="text-right px-4 py-3 text-xs font-semibold text-slate-400 uppercase tracking-widest sortable" data-col="total_spend">Spend</th>
              <th class="text-right px-4 py-3 text-xs font-semibold text-slate-400 uppercase tracking-widest sortable" data-col="registered">Reg</th>
              <th class="text-right px-4 py-3 text-xs font-semibold text-slate-400 uppercase tracking-widest sortable" data-col="attended">Attend</th>
              <th class="text-right px-4 py-3 text-xs font-semibold text-slate-400 uppercase tracking-widest sortable" data-col="consult_booked">Consult Booked</th>
              <th class="text-right px-4 py-3 text-xs font-semibold text-slate-400 uppercase tracking-widest sortable" data-col="consult_completed">Consult Done</th>
              <th class="text-right px-4 py-3 text-xs font-semibold text-slate-400 uppercase tracking-widest sortable" data-col="closed_won">Closed / Won</th>
              <th class="text-right px-4 py-3 text-xs font-semibold text-slate-400 uppercase tracking-widest sortable" data-col="cost_per_attendee">$/Attend</th>
              <th class="text-right px-4 py-3 text-xs font-semibold text-slate-400 uppercase tracking-widest sortable" data-col="close_rate_pct">Close%</th>
              <th class="text-right px-5 py-3 text-xs font-semibold text-slate-400 uppercase tracking-widest sortable" data-col="cost_per_sale">$/Sale</th>
            </tr>
          </thead>
          <tbody id="seminar-table-body">
            <tr>
              <td colspan="10" class="text-center px-5 py-10 text-slate-500 text-sm">
                Apply filters to load data
              </td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>

    <!-- All Leads -->
    <div class="bg-slate-800 border border-slate-700 rounded-xl overflow-hidden">
      <div class="px-6 py-4 border-b border-slate-700 flex items-center justify-between">
        <p class="text-xs font-semibold text-slate-500 uppercase tracking-widest">All Leads</p>
        <span id="leads-count-badge" class="text-xs text-slate-500"></span>
      </div>
      <div class="overflow-x-auto">
        <table class="w-full text-sm whitespace-nowrap">
          <thead>
            <tr class="border-b border-slate-700">
              <th class="text-left px-5 py-3 text-xs font-semibold text-slate-400 uppercase tracking-widest">Name</th>
              <th class="text-left px-4 py-3 text-xs font-semibold text-slate-400 uppercase tracking-widest">Email</th>
              <th class="text-left px-4 py-3 text-xs font-semibold text-slate-400 uppercase tracking-widest">Phone</th>
              <th class="text-left px-4 py-3 text-xs font-semibold text-slate-400 uppercase tracking-widest">Stage</th>
              <th class="text-left px-4 py-3 text-xs font-semibold text-slate-400 uppercase tracking-widest">Seminar</th>
              <th class="text-left px-4 py-3 text-xs font-semibold text-slate-400 uppercase tracking-widest">Received</th>
            </tr>
          </thead>
          <tbody id="leads-table-body">
            <tr><td colspan="6" class="text-center py-10 text-slate-500">Apply filters to load data</td></tr>
          </tbody>
        </table>
      </div>
    </div>

  </main>
  </div><!-- /page-dashboard -->

  <!-- Webhook Tab -->
  <div id="page-webhook" class="hidden">
  <main class="max-w-screen-2xl mx-auto px-6 py-6 space-y-5">

    <!-- Setup Card -->
    <div class="bg-slate-800 border border-slate-700 rounded-xl p-6 space-y-6">
      <p class="text-xs font-semibold text-slate-500 uppercase tracking-widest">GHL Webhook Setup</p>

      <div class="grid md:grid-cols-2 gap-5">

        <!-- URL -->
        <div>
          <p class="text-xs text-slate-400 font-medium mb-2">Webhook URL</p>
          <div class="flex items-center gap-2 bg-slate-900 border border-slate-700 rounded-lg px-4 py-3">
            <code class="text-sm text-blue-300 flex-1 break-all" id="webhook-url">—</code>
            <button id="copy-url-btn" onclick="copyWebhookUrl()"
              class="shrink-0 text-xs bg-slate-700 hover:bg-slate-600 active:scale-95 text-white px-3 py-1.5 rounded-lg transition-all">
              Copy
            </button>
          </div>
          <p class="text-xs text-slate-500 mt-2">Paste this as the webhook endpoint in your GHL workflow.</p>
        </div>

        <!-- Auth Header -->
        <div>
          <p class="text-xs text-slate-400 font-medium mb-2">Required Header</p>
          <div class="bg-slate-900 border border-slate-700 rounded-lg px-4 py-3 space-y-2.5">
            <div class="flex items-center gap-2 flex-wrap">
              <code class="text-xs text-slate-200 bg-slate-800 px-2 py-1 rounded">x-webhook-secret</code>
              <span class="text-slate-600">→</span>
              <code class="text-xs text-slate-200 bg-slate-800 px-2 py-1 rounded">your GHL_WEBHOOK_SECRET value</code>
            </div>
            <div class="flex items-center gap-2">
              <span class="text-xs text-slate-400">Secret status:</span>
              <span id="secret-status" class="text-xs font-semibold text-slate-500">Checking…</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Steps -->
      <div class="border-t border-slate-700 pt-5">
        <p class="text-xs text-slate-400 font-semibold mb-3 uppercase tracking-widest">GHL Configuration Steps</p>
        <ol class="space-y-2.5">
